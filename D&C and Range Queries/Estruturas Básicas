#pragma once
#include <bits/stdc++.h>
using namespace std;
using ll = long long;

// Índices públicos a partir de zero. Consultas em [l, r).
struct Fenwick {
    int n;
    vector<ll> bit;

    Fenwick(int n) : n(n), bit(n + 1, 0) {}

    // Soma delta a a[i]. O(log n).
    void add(int i, ll delta) {
        for (i++; i <= n; i += i & -i) bit[i] += delta;
    }

    // Soma de [0, r). O(log n).
    ll prefixo(int r) const {
        ll soma = 0;
        for (; r > 0; r -= r & -r) soma += bit[r];
        return soma;
    }

    ll query(int l, int r) const {
        return prefixo(r) - prefixo(l);
    }
};

// Segment tree de somas. Índices a partir de zero, consultas em [l, r).
struct SegTree {
    int base = 1;
    vector<ll> seg;

    SegTree(const vector<ll>& a) {
        while (base < (int)a.size()) base *= 2;
        seg.assign(2 * base, 0);
        for (int i = 0; i < (int)a.size(); i++) seg[base + i] = a[i];
        for (int i = base - 1; i > 0; i--) seg[i] = seg[2 * i] + seg[2 * i + 1];
    }

    // Substitui a[i] por valor. O(log n).
    void update(int i, ll valor) {
        i += base;
        seg[i] = valor;
        for (i /= 2; i > 0; i /= 2) seg[i] = seg[2 * i] + seg[2 * i + 1];
    }

    ll query(int l, int r) const {
        ll soma = 0;
        for (l += base, r += base; l < r; l /= 2, r /= 2) {
            if (l % 2 == 1) soma += seg[l++];
            if (r % 2 == 1) soma += seg[--r];
        }
        return soma;
    }
};

// O(n log n). Ordena a ao final e conta pares i < j com a[i] > a[j].
ll inversoes(vector<int>& a, vector<int>& aux, int l, int r) {
    if (r - l <= 1) return 0;
    int m = l + (r - l) / 2;
    ll total = inversoes(a, aux, l, m) + inversoes(a, aux, m, r);
    int i = l, j = m;
    for (int k = l; k < r; k++) {
        if (i < m && (j == r || a[i] <= a[j])) aux[k] = a[i++];
        else {
            aux[k] = a[j++];
            total += m - i;
        }
    }
    copy(aux.begin() + l, aux.begin() + r, a.begin() + l);
    return total;
}
